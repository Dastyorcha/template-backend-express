{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prepare-branch.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/inject-docs.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-branch.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-paths.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scan-secrets.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prepare-branch.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/track-session-files.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-prettier.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/update-docs.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-doc-sync.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/open-pr.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["*"]
  }
}

PORT=5000
MONGO_URI=mongodb://localhost:27017/template-backend-express
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# Token lifetimes
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string-at-least-32-chars

# SMTP (Gmail app password recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-user@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Template Backend <noreply@example.com>"
